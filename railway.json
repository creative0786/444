{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo building!"
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "startCommand": "echo starting!",
    "healthcheckPath": "/",
    "preDeployCommand": [
      "npm run db:migrate"
    ],
    "sleepApplication": false,
    "useLegacyStacker": false,
    "multiRegionConfig": {
      "us-west2": {
        "numReplicas": 1
      }
    },
    "restartPolicyType": "NEVER",
    "healthcheckTimeout": 100
  }
}
